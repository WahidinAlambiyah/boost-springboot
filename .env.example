# =========================
# Backend (Spring Boot)
# =========================
DB_NAME=boost
DB_USER=boost
DB_PASSWORD=boost
DB_SCHEMA=fastworks_springboot
DB_HOST=localhost
DB_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=false

SECURITY_ENABLED=true
METHOD_SECURITY_ENABLED=true
JWT_SECRET=change-me-please-change-me-please-change-me

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123
LOG_PRETTY=false

# =========================
# Frontend (Next.js / Vercel)
# =========================
# Untuk local dev frontend.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Endpoint collector untuk runtime error logging browser.
# Kosongkan jika belum ada collector/logging API.
NEXT_PUBLIC_RUNTIME_LOG_ENDPOINT=

# =========================
# Vercel Environment (Reference)
# =========================
# Development (Preview):
# NEXT_PUBLIC_APP_ENV=development
# NEXT_PUBLIC_API_URL=https://api-dev.example.com
# NEXT_PUBLIC_RUNTIME_LOG_ENDPOINT=https://api-dev.example.com/observability/runtime-errors
#
# Staging (Preview):
# NEXT_PUBLIC_APP_ENV=staging
# NEXT_PUBLIC_API_URL=https://api-staging.example.com
# NEXT_PUBLIC_RUNTIME_LOG_ENDPOINT=https://api-staging.example.com/observability/runtime-errors
#
# Production:
# NEXT_PUBLIC_APP_ENV=production
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_RUNTIME_LOG_ENDPOINT=https://api.example.com/observability/runtime-errors
