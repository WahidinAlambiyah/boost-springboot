              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{baseUrl}}{{graphqlPath}}",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query($id: ID!) { product(id: $id) { id name sku price category { id name } } }\",\n  \"variables\": { \"id\": \"{{product_id}}\" }\n}" }
          },
          "response": []
        },
        {
          "name": "List products (paging)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
