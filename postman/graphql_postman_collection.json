            ],
            "url": "{{baseUrl}}{{graphqlPath}}",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query($page: Int!, $size: Int!) { roles(page: $page, size: $size) { items { id name } total page size } }\",\n  \"variables\": { \"page\": {{page}}, \"size\": {{size}} }\n}" }
          },
          "response": []
        },
        {
          "name": "Create role",
          "request": {
