            ],
            "url": "{{baseUrl}}{{graphqlPath}}",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation($input: CreateRoleInput!) { createRole(input: $input) { id name } }\",\n  \"variables\": { \"input\": { \"name\": \"ADMIN\" } }\n}" }
          },
          "response": []
        },
        {
          "name": "Update role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{baseUrl}}{{graphqlPath}}",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation($id: ID!, $input: UpdateRoleInput!) { updateRole(id: $id, input: $input) { id name } }\",\n  \"variables\": { \"id\": \"{{role_id}}\", \"input\": { \"name\": \"ADMIN_UPDATED\" } }\n}" }
          },
          "response": []
        },
        {
          "name": "Delete role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{baseUrl}}{{graphqlPath}}",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"mutation($id: ID!) { deleteRole(id: $id) }\",\n  \"variables\": { \"id\": \"{{role_id}}\" }\n}" }
          },
          "response": []
        }
      ]
    },

