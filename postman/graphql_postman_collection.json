            ],
            "url": "{{baseUrl}}{{graphqlPath}}",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query($id: ID!) { category(id: $id) { id name parent { id name } children { id name } } }\",\n  \"variables\": { \"id\": \"{{category_id}}\" }\n}" }
          },
          "response": []
