              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{baseUrl}}{{graphqlPath}}",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query($page: Int!, $size: Int!) { categories(page: $page, size: $size) { items { id name } total page size } }\",\n  \"variables\": { \"page\": {{page}}, \"size\": {{size}} }\n}" }
          },
