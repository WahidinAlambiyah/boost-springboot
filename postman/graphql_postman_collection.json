            ],
            "url": "{{baseUrl}}{{graphqlPath}}",
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query($page: Int!, $size: Int!) { products(page: $page, size: $size) { items { id name sku price } total page size } }\",\n  \"variables\": { \"page\": {{page}}, \"size\": {{size}} }\n}" }
          },
